{
    "name": "sendtoai",
    "displayName": "Send to AI \u2014 Copy Your Whole Project or Codebase into ChatGPT, Claude & Gemini",
    "description": "Copy your entire project, codebase or repo context into any AI chat in one click. Bundle your errors + the connected code into one paste-ready block \u2014 then paste the reply back and apply the edits to your files. No API key. Free tier bundles the 50 most relevant files; Pro bundles the whole project.",
    "version": "3.10.0",
    "publisher": "oxainz",
    "icon": "resources/icon.png",
    "license": "MIT",
    "pricing": "Free",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "AI",
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "ai",
        "chatgpt",
        "claude",
        "gemini",
        "gpt",
        "openai",
        "anthropic",
        "llm",
        "copy project",
        "copy codebase",
        "paste code",
        "clipboard",
        "code context",
        "context bundler",
        "project bundler",
        "code to prompt",
        "repo to text",
        "prompt",
        "prompt engineering",
        "tokens",
        "token estimation",
        "context window",
        "apply ai reply",
        "bundle errors",
        "fix errors",
        "ai code review",
        "share code with ai",
        "copilot alternative",
        "code analysis",
        "ai assistant"
    ],
    "activationEvents": [
        "onView:sendtoai.panel"
    ],
    "main": "./out/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/oxainz/sendtoai-vscode"
    },
    "bugs": {
        "url": "https://github.com/oxainz/sendtoai-vscode/issues"
    },
    "homepage": "https://sendtoai.dev",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "sendtoai",
                    "title": "SendToAI",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "sendtoai": [
                {
                    "type": "webview",
                    "id": "sendtoai.panel",
                    "name": "Send to AI"
                }
            ]
        },
        "commands": [
            {
                "command": "sendtoai.sendToAI",
                "title": "\ud83d\udccb Send to AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.bundleProject",
                "title": "\ud83d\ude80 Bundle Project for AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.bundleErrors",
                "title": "\ud83d\udc1b Bundle Errors for AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.applyResponse",
                "title": "\ud83d\udce5 Apply AI Response (paste-back)",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.upgradeToPro",
                "title": "\ud83d\udc8e Upgrade to Pro ($9 lifetime)",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.enterLicenseKey",
                "title": "\ud83d\udd11 Enter License Key",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.deactivateLicense",
                "title": "\ud83d\udd13 Deactivate License on This Machine",
                "category": "Send to AI"
            }
        ],
        "keybindings": [
            {
                "command": "sendtoai.sendToAI",
                "key": "ctrl+alt+a",
                "mac": "cmd+alt+a",
                "when": "editorTextFocus"
            },
            {
                "command": "sendtoai.bundleProject",
                "key": "ctrl+alt+b",
                "mac": "cmd+alt+b"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "sendtoai.sendToAI",
                    "group": "sendtoai",
                    "when": "editorTextFocus"
                },
                {
                    "command": "sendtoai.bundleProject",
                    "group": "sendtoai"
                }
            ],
            "explorer/context": [
                {
                    "command": "sendtoai.bundleProject",
                    "group": "sendtoai"
                }
            ]
        },
        "configuration": {
            "title": "Send to AI",
            "properties": {
                "sendtoai.licenseKey": {
                    "type": "string",
                    "default": "",
                    "description": "Pro license key (purchase at https://sendtoai.dev for $9 lifetime)",
                    "pattern": "^([A-Z0-9]{8}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{12})?$"
                },
                "sendtoai.autoOpenAI": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically open AI chat interface after copying content"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "publish:ovsx": "npx ovsx publish -p $OVSX_TOKEN"
    },
    "devDependencies": {
        "@types/node": "16.x",
        "@types/vscode": "^1.74.0",
        "@vscode/vsce": "^3.9.1",
        "typescript": "^4.9.4",
        "ovsx": "^0.10.1"
    },
    "overrides": {
        "undici": ">=7.28.0",
        "markdown-it": ">=14.1.0"
    }
}
