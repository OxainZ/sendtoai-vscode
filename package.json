{
    "name": "sendtoai",
    "displayName": "Send to AI — Copy Codebase to ChatGPT, Claude & Gemini",
    "description": "Copy your codebase into ChatGPT, Claude or Gemini in one paste, then apply the AI's edits back to your files. Bundles the errors from the Problems panel with the code they point at. No API key, no telemetry, nothing leaves your machine. Free: the 50 most relevant files. Pro ($9.99 once): the whole project.",
    "version": "3.15.0",
    "publisher": "oxainz",
    "icon": "resources/icon.png",
    "license": "MIT",
    "pricing": "Free",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.74.0",
        "node": ">=20"
    },
    "categories": [
        "AI",
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "copy codebase",
        "copy project",
        "codebase to prompt",
        "repo to text",
        "copy for ai",
        "paste codebase",
        "code to prompt",
        "project to prompt",
        "context bundler",
        "ai context",
        "llm context",
        "chatgpt",
        "claude",
        "gemini",
        "deepseek",
        "apply ai reply",
        "bundle errors",
        "fix errors with ai",
        "ai code review",
        "share code with ai",
        "token count",
        "context window",
        "prompt",
        "ai assistant",
        "clipboard",
        "no api key",
        "privacy",
        "offline",
        "whole project",
        "git diff"
    ],
    "activationEvents": [
        "onView:sendtoai.panel"
    ],
    "main": "./out/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/OxainZ/sendtoai-vscode"
    },
    "bugs": {
        "url": "https://github.com/OxainZ/sendtoai-vscode/issues"
    },
    "homepage": "https://sendtoai.dev",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "sendtoai",
                    "title": "SendToAI",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "sendtoai": [
                {
                    "type": "webview",
                    "id": "sendtoai.panel",
                    "name": "Send to AI"
                }
            ]
        },
        "commands": [
            {
                "command": "sendtoai.sendToAI",
                "title": "📋 Send to AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.bundleProject",
                "title": "🚀 Bundle Project for AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.bundleErrors",
                "title": "🐛 Bundle Errors for AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.applyResponse",
                "title": "📥 Apply AI Response (paste-back)",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.upgradeToPro",
                "title": "💎 Upgrade to Pro ($9.99 lifetime)",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.enterLicenseKey",
                "title": "🔑 Enter License Key",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.deactivateLicense",
                "title": "🔓 Deactivate License on This Machine",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.showLicenseActivity",
                "title": "📜 Show License Activity",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.saveBundle",
                "title": "💾 Save Bundle as .txt",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.rateExtension",
                "title": "⭐ Rate Send to AI",
                "category": "Send to AI"
            }
        ],
        "keybindings": [
            {
                "command": "sendtoai.sendToAI",
                "key": "ctrl+alt+a",
                "mac": "cmd+alt+a",
                "when": "editorTextFocus"
            },
            {
                "command": "sendtoai.bundleProject",
                "key": "ctrl+alt+b",
                "mac": "cmd+alt+b"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "sendtoai.sendToAI",
                    "group": "sendtoai",
                    "when": "editorTextFocus"
                },
                {
                    "command": "sendtoai.bundleProject",
                    "group": "sendtoai"
                }
            ],
            "explorer/context": [
                {
                    "command": "sendtoai.bundleProject",
                    "group": "sendtoai"
                }
            ]
        },
        "configuration": {
            "title": "Send to AI",
            "properties": {
                "sendtoai.licenseKey": {
                    "type": "string",
                    "default": "",
                    "description": "Pro license key (purchase at https://sendtoai.dev). Stored per machine and never synced by Settings Sync — each machine activates its own slot.",
                    "pattern": "^([A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12})?$",
                    "scope": "machine"
                },
                "sendtoai.autoOpenAI": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically open AI chat interface after copying content"
                }
            }
        },
        "walkthroughs": [
            {
                "id": "sendtoai.gettingStarted",
                "title": "Send to AI in 60 seconds",
                "description": "Bundle your code, paste it into any AI chat, paste the reply back.",
                "steps": [
                    {
                        "id": "open",
                        "title": "Open the panel",
                        "description": "Send to AI lives in the Activity Bar. The panel scans your project and lets you tick the files that matter.\n[Open the panel](command:sendtoai.panel.focus)",
                        "media": {
                            "markdown": "media/walkthrough/open.md"
                        },
                        "completionEvents": [
                            "onView:sendtoai.panel"
                        ]
                    },
                    {
                        "id": "bundle",
                        "title": "Bundle and paste",
                        "description": "Click **Bundle to Clipboard**, then paste into ChatGPT, Claude or Gemini. The free tier bundles the 50 most relevant files; Pro bundles everything.\n[Bundle the current project](command:sendtoai.bundleProject)",
                        "media": {
                            "markdown": "media/walkthrough/bundle.md"
                        },
                        "completionEvents": [
                            "onCommand:sendtoai.bundleProject"
                        ]
                    },
                    {
                        "id": "errors",
                        "title": "Fix a wall of errors in one paste",
                        "description": "Bundle Errors reads the Problems panel and packs every file with a diagnostic, plus the diagnostics themselves, into one prompt.\n[Bundle Errors](command:sendtoai.bundleErrors)",
                        "media": {
                            "markdown": "media/walkthrough/errors.md"
                        },
                        "completionEvents": [
                            "onCommand:sendtoai.bundleErrors"
                        ]
                    },
                    {
                        "id": "apply",
                        "title": "Apply the reply",
                        "description": "Copy the AI's full reply, then run Apply AI Reply. Every file block becomes an edit you can review and undo.\n[Apply AI Reply](command:sendtoai.applyResponse)",
                        "media": {
                            "markdown": "media/walkthrough/apply.md"
                        },
                        "completionEvents": [
                            "onCommand:sendtoai.applyResponse"
                        ]
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "publish:ovsx": "npx ovsx publish -p $OVSX_TOKEN",
        "test": "npm run compile && node --check media/panel.js && node --test test/bundler.test.cjs test/extension.test.cjs test/panel.test.cjs",
        "test:worker": "cd worker && node --test test/index.test.js",
        "lint": "eslint .",
        "test:e2e": "npm run compile && node test/e2e/runTests.cjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "16.x",
        "@types/vscode": "^1.144.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^4.1.0",
        "eslint": "^9.39.5",
        "globals": "^15.15.0",
        "jsdom": "^25.0.1",
        "ovsx": "^0.10.1",
        "typescript": "^4.9.4",
        "typescript-eslint": "^8.72.1"
    },
    "overrides": {
        "undici": ">=7.31.0",
        "markdown-it": ">=14.1.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Bundling and copying work in Restricted Mode. Apply AI Reply, which writes files, requires a trusted workspace."
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "Needs a local or remote file system to read files."
        }
    }
}
