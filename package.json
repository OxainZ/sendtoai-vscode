{
    "name": "sendtoai",
    "displayName": "Send to AI — Copy Your Whole Project or Codebase into ChatGPT, Claude & Gemini",
    "description": "Copy your entire project, codebase or repo context into any AI chat in one click. Bundle your errors + the connected code into one paste-ready block — then paste the reply back and apply the edits to your files. No API key. Free tier bundles the 50 most relevant files; Pro bundles the whole project.",
    "version": "3.12.0",
    "publisher": "oxainz",
    "icon": "resources/icon.png",
    "license": "MIT",
    "pricing": "Free",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.74.0",
        "node": ">=20"
    },
    "categories": [
        "AI",
        "Machine Learning",
        "Other"
    ],
    "keywords": [
        "ai",
        "chatgpt",
        "claude",
        "gemini",
        "gpt",
        "openai",
        "anthropic",
        "llm",
        "copy project",
        "copy codebase",
        "paste code",
        "clipboard",
        "code context",
        "context bundler",
        "project bundler",
        "code to prompt",
        "repo to text",
        "prompt",
        "prompt engineering",
        "tokens",
        "token estimation",
        "context window",
        "apply ai reply",
        "bundle errors",
        "fix errors",
        "ai code review",
        "share code with ai",
        "copilot alternative",
        "code analysis",
        "ai assistant"
    ],
    "activationEvents": [
        "onView:sendtoai.panel"
    ],
    "main": "./out/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/OxainZ/sendtoai-vscode"
    },
    "bugs": {
        "url": "https://github.com/OxainZ/sendtoai-vscode/issues"
    },
    "homepage": "https://sendtoai.dev",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "sendtoai",
                    "title": "SendToAI",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "sendtoai": [
                {
                    "type": "webview",
                    "id": "sendtoai.panel",
                    "name": "Send to AI"
                }
            ]
        },
        "commands": [
            {
                "command": "sendtoai.sendToAI",
                "title": "📋 Send to AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.bundleProject",
                "title": "🚀 Bundle Project for AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.bundleErrors",
                "title": "🐛 Bundle Errors for AI",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.applyResponse",
                "title": "📥 Apply AI Response (paste-back)",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.upgradeToPro",
                "title": "💎 Upgrade to Pro ($9.99 lifetime)",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.enterLicenseKey",
                "title": "🔑 Enter License Key",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.deactivateLicense",
                "title": "🔓 Deactivate License on This Machine",
                "category": "Send to AI"
            },
            {
                "command": "sendtoai.showLicenseActivity",
                "title": "📜 Show License Activity",
                "category": "Send to AI"
            }
        ],
        "keybindings": [
            {
                "command": "sendtoai.sendToAI",
                "key": "ctrl+alt+a",
                "mac": "cmd+alt+a",
                "when": "editorTextFocus"
            },
            {
                "command": "sendtoai.bundleProject",
                "key": "ctrl+alt+b",
                "mac": "cmd+alt+b"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "sendtoai.sendToAI",
                    "group": "sendtoai",
                    "when": "editorTextFocus"
                },
                {
                    "command": "sendtoai.bundleProject",
                    "group": "sendtoai"
                }
            ],
            "explorer/context": [
                {
                    "command": "sendtoai.bundleProject",
                    "group": "sendtoai"
                }
            ]
        },
        "configuration": {
            "title": "Send to AI",
            "properties": {
                "sendtoai.licenseKey": {
                    "type": "string",
                    "default": "",
                    "description": "Pro license key (purchase at https://sendtoai.dev). Stored per machine and never synced by Settings Sync — each machine activates its own slot.",
                    "pattern": "^([A-Za-z0-9]{8}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{12})?$",
                    "scope": "machine"
                },
                "sendtoai.autoOpenAI": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically open AI chat interface after copying content"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "publish:ovsx": "npx ovsx publish -p $OVSX_TOKEN",
        "test": "npm run compile && node --test test/bundler.test.cjs test/extension.test.cjs",
        "test:worker": "cd worker && node --test test/index.test.js"
    },
    "devDependencies": {
        "@types/node": "16.x",
        "@types/vscode": "^1.74.0",
        "@vscode/vsce": "^4.1.0",
        "ovsx": "^0.10.1",
        "typescript": "^4.9.4"
    },
    "overrides": {
        "undici": ">=7.31.0",
        "markdown-it": ">=14.1.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Bundling and copying work in Restricted Mode. Apply AI Reply, which writes files, requires a trusted workspace."
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "Needs a local or remote file system to read files."
        }
    }
}
