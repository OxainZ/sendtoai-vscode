{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "process",
      "command": "node",
      "args": ["./node_modules/typescript/bin/tsc", "-p", "./"],
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      "label": "watch",
      "type": "process",
      "command": "node",
      "args": ["./node_modules/typescript/bin/tsc", "-watch", "-p", "./"],
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "group": "build"
    }
  ]
}
